# Copy to backend/.env (what the Quickstart calls agent/.env) or to a repo-root
# .env. Never commit the filled-in file.

# ── Required ────────────────────────────────────────────────────────────────

# The only key this repo needs. Every LlamaIndex doc sample uses OpenAI.
OPENAI_API_KEY=sk-...


# ── Backend, optional ───────────────────────────────────────────────────────

# The docs hardcode `OpenAI(model="gpt-5.4")` on every page. That id is not
# served by the OpenAI API, so backend/llm.py defaults to gpt-4o-mini and reads
# this variable as the override. Set it to gpt-5.4 to reproduce the doc call
# exactly (and watch every route fail with a model-not-found error).
# OPENAI_CHAT_MODEL_ID=gpt-4o-mini

# Port for the FastAPI AG-UI server. Change this and LLAMAINDEX_AGENT_URL
# together.
# AGENT_PORT=8000


# ── Frontend, optional ──────────────────────────────────────────────────────
# These belong in frontend/.env.local — Next.js does not read this file.

# Where the Copilot Runtime reaches the AG-UI server. Use 127.0.0.1 if localhost
# resolves to IPv6 while uvicorn binds IPv4.
# LLAMAINDEX_AGENT_URL=http://localhost:8000

# ── CopilotKit Intelligence ─────────────────────────────────────────────────
# Also frontend/.env.local — the runtime route runs inside the Next process.

# Project API key for CopilotKit Intelligence. Provision one with
#   npx copilotkit login && npx copilotkit project select
# which writes it to .env, or copy it from the cloud dashboard.
#
# SERVER-SIDE SECRET. Never give it a NEXT_PUBLIC_ prefix — that ships it to the
# browser. The runtime reads it directly; the provider never sees it.
#
# Leave it unset and the runtime falls back to SSE mode with an in-memory
# runner: every chat route still works, Threads and the Inspector's Threads tab
# stay locked, and the key is never read.
# INTELLIGENCE_API_KEY=cpk-...

# A SECOND, SEPARATE credential — and the one the Threads Drawer gates on.
#
# INTELLIGENCE_API_KEY above authorizes the runtime against the platform: it is
# what makes /info report mode "intelligence" and what makes the thread
# endpoints return real rows. It does NOT advertise a license.
#
# This does. The runtime builds a licenseChecker from it, and /info reports
# licenseStatus off that checker — "none" when there is no checker at all.
# <CopilotThreadsDrawer> renders its locked "Upgrade" view unless that status is
# "valid" or "expiring", so without this the drawer stays locked even though
# threads work perfectly everywhere else. /headless-threads is not gated this
# way and is the quickest way to confirm that.
#
# Server-side secret, like the key above.
# COPILOTKIT_LICENSE_TOKEN=...

# Identity the provider sends as x-user-id / x-user-name, which the runtime's
# identifyUser callback turns into a per-user thread history. Change these to
# watch two "users" get separate thread lists. A real app would derive this from
# a verified session instead of an env var.
# NEXT_PUBLIC_DEMO_USER_ID=harness-local
# NEXT_PUBLIC_DEMO_USER_NAME=Harness User

# Origin the home page uses for its server-side GET /api/copilotkit/info probe.
# Defaults to http://127.0.0.1:$PORT — set it only behind a proxy.
# NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
